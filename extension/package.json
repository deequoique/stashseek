{
  "name": "stashseek-chat-browser-companion",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && vite build --config vite.config.ts && node scripts/copy-static.mjs production",
    "build:local": "node scripts/clean.mjs && tsc -p tsconfig.json && vite build --config vite.config.ts && node scripts/copy-static.mjs local",
    "audit": "node scripts/audit-package.mjs production",
    "audit:local": "node scripts/audit-package.mjs local",
    "package": "pnpm build && pnpm run audit",
    "package:local": "pnpm build:local && pnpm run audit:local",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --max-warnings 0",
    "check:api": "node workspace/openapi.mjs check",
    "generate:api": "node workspace/openapi.mjs generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "vite": "8.2.1"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router": "8.3.0"
  }
}
