{
  "manifest_version": 3,
  "name": "StashSeek Chat — 搜藏助手",
  "version": "0.2.0",
  "description": "在侧边栏就当前视频提问并跳转到原文时间点，也可以把字幕保存到资料库。",
  "key": "",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtu.be/*",
    "https://www.bilibili.com/*",
    "https://ntulearn.ntu.edu.sg/*",
    "https://ntulearnvideo.ntu.edu.sg/*",
    "https://ntulearnv1.ntu.edu.sg/*",
    "https://cdnapisec.kaltura.com/*",
    "https://notebookai.deequoique.tech/*"
  ],
  "background": { "service_worker": "worker.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "打开搜藏助手" }
}
