+class TLSConfigurationError(RuntimeError):
+    """Raised when an explicit OpenClaw CA override is not usable."""
+
+
+@dataclass(frozen=True)
+class TrustedCA:
+    bundle_path: str | None
+    ssl_context: ssl.SSLContext
+
+
+def _readable_bundle(path_value: str, source: str) -> str:
+    path = Path(path_value)
+    if not path.is_file() or not os.access(path, os.R_OK):
+        raise TLSConfigurationError(f'{source} must name a readable CA bundle')
+    try:
+        ssl.create_default_context(cafile=str(path))
+    except (OSError, ssl.SSLError) as exc:
+        raise TLSConfigurationError(f'{source} cannot be loaded as a CA bundle') from exc
+    return str(path)
+
+
+def configure_explicit_trusted_ca(configured_bundle: str | None = None) -> TrustedCA | None:
+    """Build client-local TLS trust only for an explicit CA override."""
+    candidates = (
+        ('adapter tls_ca_bundle', configured_bundle),
+        ('TLS_CA_BUNDLE', os.environ.get('TLS_CA_BUNDLE')),
+    )
+    for source, candidate in candidates:
+        if candidate:
+            bundle_path = _readable_bundle(candidate, source)
+            context = ssl.create_default_context(cafile=bundle_path)
+            return TrustedCA(bundle_path=bundle_path, ssl_context=context)
+    return None
+
+
+def is_certificate_verification_error(exc: BaseException) -> bool:
+    """Identify certificate failures without depending on provider error text."""
+    pending: list[BaseException] = [exc]
+    visited: set[int] = set()
+    while pending:
+        current = pending.pop()
+        if id(current) in visited:
+            continue
+        visited.add(id(current))
+        if isinstance(current, (aiohttp.ClientConnectorCertificateError, ssl.SSLCertVerificationError)):
+            return True
+        for nested in (getattr(current, '__cause__', None), getattr(current, '__context__', None), getattr(current, 'os_error', None)):
+            if isinstance(nested, BaseException):
+                pending.append(nested)
+    return False
+
