#!/bin/bash
set -euo pipefail

if [[ -n "${SSH_ORIGINAL_COMMAND:-}" ]]; then
  request=$SSH_ORIGINAL_COMMAND
else
  request="${1:-} ${2:-}"
fi

if [[ ! $request =~ ^deploy\ ([0-9a-f]{40})$ ]]; then
  echo "refusing unsupported deploy request" >&2
  exit 64
fi

release_sha=${BASH_REMATCH[1]}
repository=/opt/notebook-agent/repository
releases=/opt/notebook-agent/releases
release_dir=$releases/$release_sha
current=/opt/notebook-agent/current
lock_file=/run/lock/notebook-agent-production.lock
asr_unit=notebook-agent-asr-worker.service

# The ASR worker is optional. Hosts that have not installed its unit keep
# deploying exactly as before; once installed it is stopped, restarted and
# rolled back together with the other background units.
asr_unit_installed() {
  systemctl cat "$asr_unit" >/dev/null 2>&1
}

exec 9>"$lock_file"
if ! flock -n 9; then
  echo "another production deployment is active" >&2
  exit 75
fi

if [[ ! -d $repository/.git ]]; then
  echo "production repository is not initialized" >&2
  exit 69
fi

runuser -u notebook-agent -- git -C "$repository" fetch --quiet origin main
main_sha=$(runuser -u notebook-agent -- git -C "$repository" rev-parse origin/main)
if [[ $main_sha != "$release_sha" ]]; then
  echo "requested revision is not the current origin/main" >&2
  exit 65
fi

if [[ ! -d $release_dir ]]; then
  runuser -u notebook-agent -- git -C "$repository" worktree add --detach "$release_dir" "$release_sha"
  runuser -u notebook-agent -- python3 -m venv "$release_dir/.venv"
  runuser -u notebook-agent -- "$release_dir/.venv/bin/python" -m pip install --quiet --upgrade pip
  runuser -u notebook-agent -- "$release_dir/.venv/bin/python" -m pip install --quiet -e "$release_dir"
  # The browser Web app and the extension share one Vite build. A failed build
  # aborts the deployment (set -e) before current is switched.
  runuser -u notebook-agent -- /usr/bin/env --chdir="$release_dir/extension" \
    corepack pnpm install --frozen-lockfile
  runuser -u notebook-agent -- /usr/bin/env --chdir="$release_dir/extension" \
    corepack pnpm build
  # Compatibility for hosts whose unit still points WEB_STATIC_DIR at web/dist.
  runuser -u notebook-agent -- mkdir -p "$release_dir/web"
  runuser -u notebook-agent -- ln -sfn ../extension/dist "$release_dir/web/dist"
  chmod 0755 "$release_dir/deploy/scripts/run-production-migrations"
  runuser -u notebook-agent -- touch "$release_dir/.release-built"
elif [[ ! -f $release_dir/.release-built ]]; then
  echo "release directory exists without a completed build marker" >&2
  exit 70
fi

if [[ -L $current ]]; then
  previous_release=$(readlink -f "$current")
else
  previous_release=
fi

ln -sfn "$release_dir" /opt/notebook-agent/current.next
systemctl stop notebook-agent-langbot.service notebook-agent-gateway.service \
  notebook-agent.service notebook-agent-worker.service notebook-agent-beat.service
if asr_unit_installed; then
  systemctl stop "$asr_unit"
fi
mv -Tf /opt/notebook-agent/current.next "$current"

rollback_release() {
  if ! systemctl stop notebook-agent-langbot.service notebook-agent-gateway.service \
    notebook-agent.service notebook-agent-worker.service notebook-agent-beat.service; then
    echo "warning: failed to stop candidate StashSeek Chat services" >&2
  fi
  if asr_unit_installed && ! systemctl stop "$asr_unit"; then
    echo "warning: failed to stop candidate ASR worker" >&2
  fi
  if [[ -n $previous_release && -d $previous_release ]]; then
    ln -sfn "$previous_release" /opt/notebook-agent/current.next
    mv -Tf /opt/notebook-agent/current.next "$current"
    if ! systemctl start notebook-agent-worker.service notebook-agent-beat.service \
      notebook-agent.service notebook-agent-gateway.service notebook-agent-langbot.service; then
      echo "warning: failed to restart previous StashSeek Chat release" >&2
    fi
    if asr_unit_installed && ! systemctl start "$asr_unit"; then
      echo "warning: failed to restart previous ASR worker" >&2
    fi
  fi
}

if ! systemctl restart notebook-agent-dependencies.service; then
  rollback_release
  echo "dependency admission failed; previous release restored" >&2
  exit 70
fi

if ! systemctl start notebook-agent-migrate.service; then
  rollback_release
  echo "migration admission failed; previous release restored" >&2
  exit 70
fi

if ! systemctl restart notebook-agent-worker.service \
  || ! systemctl restart notebook-agent-beat.service \
  || ! systemctl restart notebook-agent.service; then
  rollback_release
  echo "application startup failed; previous release restored" >&2
  exit 70
fi

if asr_unit_installed && ! systemctl restart "$asr_unit"; then
  rollback_release
  echo "ASR worker startup failed; previous release restored" >&2
  exit 70
fi

runtime_ready=false
for attempt in {1..30}; do
  if curl --fail --silent --show-error http://127.0.0.1:8800/api/v1/health >/dev/null; then
    runtime_ready=true
    break
  fi
  sleep 2
done
if [[ $runtime_ready != true ]]; then
  rollback_release
  echo "combined runtime health check failed; previous release restored" >&2
  exit 70
fi

if ! systemctl restart notebook-agent-gateway.service; then
  rollback_release
  echo "channel gateway startup failed; previous release restored" >&2
  exit 70
fi

gateway_ready=false
for attempt in {1..30}; do
  if curl --fail --silent --show-error --max-time 2 \
    http://127.0.0.1:8765/health >/dev/null; then
    gateway_ready=true
    break
  fi
  sleep 1
done
if [[ $gateway_ready != true ]]; then
  rollback_release
  echo "channel gateway health check failed; previous release restored" >&2
  exit 70
fi

langbot_started_at=$(date --iso-8601=seconds)
if ! systemctl restart notebook-agent-langbot.service; then
  rollback_release
  echo "LangBot startup failed; previous release restored" >&2
  exit 70
fi

langbot_ready=false
for attempt in {1..60}; do
  if curl --fail --silent --show-error --max-time 2 \
    http://127.0.0.1:5300/healthz >/dev/null \
    && journalctl -u notebook-agent-langbot.service --since "$langbot_started_at" \
      --no-pager -o cat \
      | grep -F 'Required plugins initialized; message adapters may start.' >/dev/null; then
    langbot_ready=true
    break
  fi
  sleep 1
done
if [[ $langbot_ready != true ]]; then
  rollback_release
  echo "LangBot required bridge readiness failed; previous release restored" >&2
  exit 70
fi

printf 'deployed %s\n' "$release_sha"
