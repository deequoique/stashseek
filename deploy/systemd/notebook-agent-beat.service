[Unit]
Description=StashSeek Chat single Celery Beat scheduler
After=network-online.target notebook-agent-dependencies.service notebook-agent-migrate.service
Wants=network-online.target
Requires=notebook-agent-dependencies.service

[Service]
Type=simple
User=notebook-agent
Group=notebook-agent
WorkingDirectory=/opt/notebook-agent/current
EnvironmentFile=/etc/notebook-agent/notebook-agent.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=STASHSEEK_ENV=production
Environment=STASHSEEK_LOG_RETRIEVAL_CONTENT=false
Environment=STASHSEEK_LOG_DIR=/var/log/notebook-agent
ExecStartPre=/usr/bin/test -f /opt/notebook-agent/current/.migration-admitted
ExecStart=/opt/notebook-agent/current/.venv/bin/celery -A app.ingest.tasks.celery_app beat --loglevel=INFO --schedule=/var/lib/notebook-agent/celerybeat-schedule --pidfile=/run/notebook-agent/celerybeat.pid
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/notebook-agent /var/log/notebook-agent /run/notebook-agent
StateDirectory=notebook-agent
StateDirectoryMode=0750
RuntimeDirectory=notebook-agent
RuntimeDirectoryMode=0750
LogsDirectory=notebook-agent
LogsDirectoryMode=0750
UMask=0027

[Install]
WantedBy=multi-user.target
