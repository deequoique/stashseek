[Unit]
Description=StashSeek Chat YouTube residential egress proxy (loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
LoadCredential=tinyproxy.conf:/etc/notebook-agent/youtube-egress/tinyproxy.conf
LoadCredential=filter:/etc/notebook-agent/youtube-egress/tinyproxy.filter
ExecStart=/usr/bin/tinyproxy -d -c ${CREDENTIALS_DIRECTORY}/tinyproxy.conf
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
